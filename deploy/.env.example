# Big Tree 部署环境变量（复制为 .env 后填写；.env 不进 git）
# MYSQL_* / MINIO_ROOT_* 与本地开发同值即可（沿用 /d/todo/.env 里的凭据）
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=exam_timeline
MYSQL_USER=
MYSQL_PASSWORD=

# MinIO 对象存储凭据
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# 预签名图片的 host（路线②）：浏览器可达地址。
# 阶段一（IP 裸访问，备案中）：http://124.220.182.134
# 阶段二（域名+TLS 后）：https://你的域名   ← 只改这一行
MINIO_PRESIGN_ENDPOINT=http://124.220.182.134

# QQ 邮箱 SMTP（注册激活/找回密码；沿用开发期邮箱）
MAIL_USERNAME=
MAIL_PASSWORD=

# JWT 签名密钥（部署专用随机串，勿与开发混用）
JWT_SECRET=
