# 个人工作区数据（含私人记忆，不上传）
.workbuddy/

# Python
__pycache__/
*.pyc

# 前端工程（node_modules/构建产物不进库）
node_modules/
dist/

# 部署/本地数据（数据库卷、上传图片等）
data/

# 废弃素材
pics/_rejected/


.env

# 本地账号凭据（密码等敏感信息，禁止入库）
secrets/

# temp/ 运行产物（验证脚本中间输出/日志/测试图片/断言脚本；verify_*.sh 与 demo 仍入库）
temp/*.json
temp/*.log
temp/*.png
temp/*.jpg
temp/*_codes.txt
temp/verify_*_assert.py

.idea
# deploy 构建产物与种子数据（jar/前端产物/压缩壁纸不进库；seed 含账号行仅留服务器本地）
deploy/api/*.jar
deploy/web/
deploy/seed.sql

# 数据库备份含用户隐私、检查脚本含凭据，禁止入库
temp/backup_*.sql
temp/minio_inspect.py
